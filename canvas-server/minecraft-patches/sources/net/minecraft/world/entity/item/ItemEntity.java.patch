+    /**
+     * An item still lying where it settled, not pushed or thrown, with every block it touches the
+     * same as then, cannot move: moving it, checking it is not stuck in a block and pulling it
+     * down would change nothing. Flowing water, a block placed or broken next to it, a piston, a
+     * push or a teleport all change what is compared, and the item moves as before.
+     */
+    private boolean canvas$resting() {
+        if (Double.isNaN(this.restX)) {
+            return false;
+        }
+
+        Vec3 movement = this.getDeltaMovement();
+        if (!this.level().canvasConfig().entities.itemEntities.skipPhysicsForRestingItems
+            || !this.onGround() || this.noPhysics || movement.y > 0.0D || movement.horizontalDistanceSqr() > 1.0E-5F
+            || this.getX() != this.restX || this.getY() != this.restY || this.getZ() != this.restZ
+            || this.isInWater() || this.isInLava() || this.canvas$restPrint() != this.restPrint) {
+            this.restX = Double.NaN;
+            return false;
+        }
+
+        return true;
+    }
+
+    /**
+     * @return a print of every block the item is in or lies on, which changes when any of them does
+     */
+    private int canvas$restPrint() {
+        net.minecraft.world.phys.AABB box = this.getBoundingBox();
+        int minX = Mth.floor(box.minX);
+        int maxX = Mth.floor(box.maxX);
+        int minY = Mth.floor(box.minY - 1.0E-6D);
+        int maxY = Mth.floor(box.maxY);
+        int minZ = Mth.floor(box.minZ);
+        int maxZ = Mth.floor(box.maxZ);
+        BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
+        Level level = this.level();
+        int print = 1;
+        for (int x = minX; x <= maxX; x++) {
+            for (int y = minY; y <= maxY; y++) {
+                for (int z = minZ; z <= maxZ; z++) {
+                    print = 31 * print + System.identityHashCode(level.getBlockState(pos.set(x, y, z)));
+                }
+            }
+        }
+
+        return print;
+    }
