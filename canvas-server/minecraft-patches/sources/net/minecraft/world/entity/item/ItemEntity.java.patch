+    private static void stack(final ItemEntity toItem, final ItemEntity fromItem) {
+        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callItemMergeEvent(fromItem, toItem)) {
+            return;
+        }
+
+        long total = toItem.getStackedAmount() + fromItem.getStackedAmount();
+        toItem.setStackedAmount(total < 0L ? Long.MAX_VALUE : total);
+        toItem.pickupDelay = Math.max(toItem.pickupDelay, fromItem.pickupDelay);
+        toItem.age = Math.min(toItem.age, fromItem.age);
+        fromItem.stackReserve = 0L;
+        fromItem.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.MERGE);
+    }
+
+    /**
+     * @return the items this entity carries: its stack and its reserve together
+     */
+    public long getStackedAmount() {
+        return this.getItem().getCount() + this.stackReserve;
+    }
+
+    /**
+     * Sets how many items this entity carries. What does not fit in its stack becomes the reserve.
+     *
+     * @param amount the amount, at least one
+     */
+    public void setStackedAmount(final long amount) {
+        ItemStack current = this.getItem();
+        if (!current.isEmpty()) {
+            this.stackTemplate = current.copyWithCount(1);
+        }
+
+        if (this.stackTemplate.isEmpty() || amount < 1L) {
+            return;
+        }
+
+        int visible = (int) Math.min(this.stackTemplate.getMaxStackSize(), amount);
+        this.stackReserve = amount - visible;
+        if (current.isEmpty() || current.getCount() != visible) {
+            this.setItem(this.stackTemplate.copyWithCount(visible));
+        }
+
+        this.stackLabelDirty = true;
+    }
+
+    // Fills the stack up from the reserve after some of it was taken. Answers whether the entity
+    // still carries items, so a pickup that emptied the stack keeps it instead of discarding it.
+    private boolean refillStack() {
+        if (this.stackReserve <= 0L || this.stackTemplate.isEmpty()) {
+            return false;
+        }
+
+        ItemStack current = this.getItem();
+        int max = this.stackTemplate.getMaxStackSize();
+        int have = current.isEmpty() ? 0 : current.getCount();
+        if (have >= max) {
+            return true;
+        }
+
+        int added = (int) Math.min(max - have, this.stackReserve);
+        this.stackReserve -= added;
+        this.setItem(this.stackTemplate.copyWithCount(have + added));
+        this.stackLabelDirty = true;
+        return true;
+    }
+
+    // The amount above the entity, sent at most once per label-refresh-ticks and only when it reads
+    // differently: the name is all that changes, never the stack, which stays full while there is a reserve.
+    private void updateStackLabel() {
+        int every = this.level() instanceof net.minecraft.server.level.ServerLevel level ? Math.max(1, level.canvasConfig().entities.itemStacking.labelRefreshTicks) : 20;
+        // Widened to long: the first update starts from Integer.MIN_VALUE, which overflowed an int
+        // subtraction into a negative gap that never reached the refresh rate.
+        if ((long) this.tickCount - this.stackLabelTick < every) {
+            return;
+        }
+
+        this.stackLabelDirty = false;
+        this.stackLabelTick = this.tickCount;
+        long amount = this.getStackedAmount();
+        if (amount > 1L && this.stacks()) {
+            if (!this.stackLabelled && this.getCustomName() != null) {
+                return;
+            }
+
+            if (!this.stackLabelled || amount != this.stackLabelShown) {
+                this.setCustomName(io.canvasmc.canvas.entity.StackedItems.label(this.getItem(), amount));
+                this.setCustomNameVisible(true);
+            }
+
+            this.stackLabelled = true;
+            this.stackLabelShown = amount;
+        } else if (this.stackLabelled) {
+            this.setCustomName(null);
+            this.setCustomNameVisible(false);
+            this.stackLabelled = false;
+        }
+    }
