+    // Canvas start - one lazy copy per broadcast, reset for each slot
+    // copies the slot's stack the first time it is asked, at most once per slot, as the memoized copy did
+    private static final class CanvasSlotCopy implements Supplier<ItemStack> {
+        private ItemStack source = ItemStack.EMPTY;
+        private @Nullable ItemStack copy;
+
+        private void reset(final ItemStack source) {
+            this.source = source;
+            this.copy = null;
+        }
+
+        @Override
+        public ItemStack get() {
+            if (this.copy == null) {
+                this.copy = this.source.copy();
+            }
+            return this.copy;
+        }
+    }
+    // Canvas end - one lazy copy per broadcast, reset for each slot
