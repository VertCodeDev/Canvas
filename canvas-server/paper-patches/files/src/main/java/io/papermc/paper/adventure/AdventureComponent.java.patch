+            if (vanilla == null) {
+                vanilla = PaperAdventure.WRAPPER_AWARE_SERIALIZER.serialize(this.adventure);
+                CONVERTED.put(this.adventure, vanilla);
+            }
+            // Canvas end
             this.vanilla = vanilla;
         }
